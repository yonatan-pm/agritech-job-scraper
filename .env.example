# AgriSupport job board URL (without #fragment)
JOBS_URL=https://www.israel.agrisupportonline.com/drushim/csv/csvread.pl?mytemplate=tp1

# EmailJS — https://www.emailjs.com
# 1) Add an Email Service (Gmail) connected to tymaayan@gmail.com
# 2) Create a template with variables: {{to_email}} {{subject}} {{message}} {{job_count}}
# 3) Copy IDs from Account → API Keys / Email Services / Email Templates
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional but recommended for Node.js (Account → API Keys → Private Key)
EMAILJS_PRIVATE_KEY=

# Recipient used in the template as {{to_email}}
NOTIFY_EMAIL=tymaayan@gmail.com

# Cron schedule (default: every day at 09:00 local time)
CRON_SCHEDULE=0 9 * * *

# How many listing pages to scan (site has ~7)
MAX_PAGES=7
